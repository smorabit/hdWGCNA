Package: hdWGCNA
Title: High Dimensional Weighted Gene Co-Expression Network Analysis
Version: 0.4.12.9000
Authors@R: c(
    person("Sam", "Morabito", , "sam.morabito@cnag.eu", role = c("aut", "cre"),
           comment = c(ORCID = "0000-0002-7768-4856")),
    person("Zechuan", "Shi", , "zechuas@uci.edu", role = "ctb",
